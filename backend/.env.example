# FinFamily Environment Configuration

# ─── Storage & Database ────────────────────────────────────────────────────────
# Mode: 'server' (Prisma with SQLite/Postgres) or 'local' (In-memory / LocalStorage simulation)
STORAGE_MODE=server
DATABASE_URL=file:./dev.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/finfamily?schema=public

# ─── Authentication & Security ────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-secure-random-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Google Gemini AI Configuration ───────────────────────────────────────────
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left empty, the application will run in graceful degradation mode (AI card omitted).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── Application Defaults ──────────────────────────────────────────────────────
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN
PORT=3000
FRONTEND_URL=http://localhost:5173
